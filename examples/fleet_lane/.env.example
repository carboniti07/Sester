# F1 filo-rayı — ortam-değişkenleri (örnek)
# Kullanım: bu dosyayı `.env` olarak kopyala, değerleri doldur.
#   cp examples/fleet_lane/.env.example examples/fleet_lane/.env
#   source examples/fleet_lane/.env   # ya da systemd EnvironmentFile=
#
# GÜVENLİK: `.env` dosyası asla git'e girmez (.gitignore'dadır). Secret'ı
# ekip-içi sır-yöneticisinden al; koda ve repoya gömme.

# Ödeme-doğrulama sırrı — ajanlarla BİREBİR aynı olmalı (farklıysa tüm
# istekler 402 alır: fail-closed).
SESTER_FLEET_SECRET="f1-fleet-secret-2026"

# Ledger DB yolu (varsayılan: examples/fleet_lane/fleet.sqlite3)
SESTER_FLEET_DB="examples/fleet_lane/fleet.sqlite3"

# Politika-dosyası (varsayılan: examples/fleet_lane/policy.json)
SESTER_FLEET_POLICY="examples/fleet_lane/policy.json"

# İstek-fiyatı ve günlük-kota (float-USDC; dahili tam-sayı-minör-eçevrimli)
SESTER_FLEET_PRICE="0.05"
SESTER_FLEET_DAILY_QUOTA="10.00"

# İstemci-tarafı: sunucu-adresi (send_paid_request.py okur)
SESTER_FLEET_BASE="http://127.0.0.1:8410"
