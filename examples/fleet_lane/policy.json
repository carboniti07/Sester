{
  "wallet_policy": {
    "id": "wpol-2026-09-f1-fleet-lane",
    "owner": "did:agent:kok:f1-treasury",
    "wallet": "evm:0xDEMO000000000000000000000000000000000000",
    "defaults": {
      "currency": "USDC-sim",
      "per_request_max": 0.50,
      "daily_max": 10.00,
      "timezone": "Europe/Istanbul"
    },
    "rules": [
      {
        "id": "allow-telemetry",
        "when": {
          "host_in": ["/telemetry", "/history"],
          "hour_between": ["07:00", "23:00"]
        },
        "then": "allow"
      },
      {
        "id": "deny-unknown-hosts",
        "when": { "host_in": [] },
        "then": "deny"
      }
    ],
    "audit": {
      "ledger": "tamga://f1-fleet/agent-payments",
      "on_violation": "block+log"
    }
  }
}
